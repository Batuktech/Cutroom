// Static site for cutroom.batuukka.com, served as Cloudflare Worker assets, plus the TikTok token service
// for Cutroom's own TikTok app (src/tiktok-token.ts). Set the secret with: npx wrangler secret put TIKTOK_CLIENT_SECRET
{
  "name": "cutroom-site",
  "account_id": "e266880475b639db7354fb33911b759a",
  "compatibility_date": "2026-11-01",
  "main": "src/worker.ts",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    // Pages stay static; only the API path runs the script.
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Cutroom's TikTok client key (public; it also appears in sign-in URLs). Leave empty until the app exists.
    "TIKTOK_CLIENT_KEY": "",
    "TIKTOK_REDIRECT_URIS": "http://127.0.0.1:4318/api/social/tiktok/callback"
  },
  // 20 token requests per minute per client IP; sign-in and hourly refreshes need far fewer.
  "ratelimits": [
    { "name": "TOKEN_LIMITER", "namespace_id": "4318", "simple": { "limit": 20, "period": 60 } }
  ],
  "observability": { "enabled": false },
  // The custom domain creates DNS and the certificate. The zone also has a *.batuukka.com/* route
  // for another Worker, so this more specific route is what actually wins for this host.
  "routes": [
    { "pattern": "cutroom.batuukka.com", "custom_domain": true },
    { "pattern": "cutroom.batuukka.com/*", "zone_name": "batuukka.com" }
  ]
}
