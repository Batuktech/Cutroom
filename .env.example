# Optional. Copy to .env to override defaults. No API keys are needed for local features.
CUTROOM_PORT=4318
CUTROOM_DATA_DIR=.cutroom
# NVIDIA Vulkan physical-device index on the tested laptop. See docs/qwen-setup.md.
CUTROOM_VULKAN_DEVICE=1

# Optional cloud clip review. API billing is separate from chat subscriptions.
# Never commit real keys. UI-entered keys last only until the server restarts.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# ZAI_API_KEY=
# MOONSHOT_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# XAI_API_KEY=
# TOGETHER_API_KEY=
# FIREWORKS_API_KEY=
# CEREBRAS_API_KEY=
# SAMBANOVA_API_KEY=
# DASHSCOPE_API_KEY=
# SILICONFLOW_API_KEY=
# CUSTOM_AI_API_KEY=
# Optional trusted HTTPS OpenAI-compatible API base. See docs/byok.md.
# CUTROOM_CUSTOM_AI_BASE_URL=https://your-trusted-provider.example/v1
